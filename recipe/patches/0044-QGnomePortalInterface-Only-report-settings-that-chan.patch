From e853ce3acf82c991555530154acc9c0c328fe25b Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Fri, 27 Nov 2026 21:28:52 -0500
Subject: [PATCH 44/44] QGnomePortalInterface: Only report settings that change

The color scheme, contrast and motion preferences start out unset, and
the getters return a fallback until the settings portal answers. The
first answer was always reported as a change, even when it was the same
as the fallback, for example "no preference" for all three. QGnomeTheme
turns each of these signals into a theme change, so on GNOME every
application repainted all its widgets up to three times shortly after
startup without anything having changed. This also made tests that
count paint events, such as tst_QWidget::update(), fail on GNOME.

Report a setting only when the value the getter returns changes.

Change-Id: Idbd1acf0b4e4110b44959141d2bb224613d86725
---
 .../platform/unix/qgnomeportalinterface.cpp   | 18 +++----
 tests/auto/gui/platform/CMakeLists.txt        |  3 ++
 .../qgnomeportalinterface/CMakeLists.txt      | 16 +++++++
 .../tst_qgnomeportalinterface.cpp             | 47 +++++++++++++++++++
 4 files changed, 75 insertions(+), 9 deletions(-)
 create mode 100644 tests/auto/gui/platform/qgnomeportalinterface/CMakeLists.txt
 create mode 100644 tests/auto/gui/platform/qgnomeportalinterface/tst_qgnomeportalinterface.cpp

diff --git a/qtbase/src/gui/platform/unix/qgnomeportalinterface.cpp b/qtbase/src/gui/platform/unix/qgnomeportalinterface.cpp
index 316bbd4d..ac6c8b60 100644
--- a/qtbase/src/gui/platform/unix/qgnomeportalinterface.cpp
+++ b/qtbase/src/gui/platform/unix/qgnomeportalinterface.cpp
@@ -165,26 +165,26 @@ void QGnomePortalInterface::querySettings()
 
 void QGnomePortalInterface::updateColorScheme(Qt::ColorScheme colorScheme)
 {
-    if (m_colorScheme.has_value() && (m_colorScheme.value() == colorScheme))
-        return;
+    const bool changed = this->colorScheme() != colorScheme;
     m_colorScheme = colorScheme;
-    emit colorSchemeChanged(colorScheme);
+    if (changed)
+        emit colorSchemeChanged(colorScheme);
 }
 
 void QGnomePortalInterface::updateContrast(Qt::ContrastPreference contrast)
 {
-    if (m_contrast.has_value() && (m_contrast.value() == contrast))
-        return;
+    const bool changed = contrastPreference() != contrast;
     m_contrast = contrast;
-    emit contrastChanged(contrast);
+    if (changed)
+        emit contrastChanged(contrast);
 }
 
 void QGnomePortalInterface::updateMotion(Qt::MotionPreference motion)
 {
-    if (m_motion.has_value() && (m_motion.value() == motion))
-        return;
+    const bool changed = motionPreference() != motion;
     m_motion = motion;
-    emit motionChanged(motion);
+    if (changed)
+        emit motionChanged(motion);
 }
 
 void QGnomePortalInterface::dbusSettingChanged(QDBusListener::Provider provider,
