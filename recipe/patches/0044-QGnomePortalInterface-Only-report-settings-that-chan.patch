new file mode 100644
index 00000000..b30cf87b
--- /dev/null
+++ b/qtbase/tests/auto/gui/platform/qgnomeportalinterface/tst_qgnomeportalinterface.cpp
@@ -0,0 +1,47 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR GPL-3.0-only
+
+#include <QtTest/qtest.h>
+#include <QtTest/qsignalspy.h>
+
+#include <QtGui/private/qgnomeportalinterface_p.h>
+
+class tst_QGnomePortalInterface : public QObject
+{
+    Q_OBJECT
+private slots:
+    void settingChangedSignals();
+};
+
+// A setting that keeps the effective value, such as "no preference" in the
+// portal's first reply, must not be reported as a change
+void tst_QGnomePortalInterface::settingChangedSignals()
+{
+    QGnomePortalInterface portal;
+    QSignalSpy colorSchemeSpy(&portal, &QGnomePortalInterface::colorSchemeChanged);
+    QSignalSpy contrastSpy(&portal, &QGnomePortalInterface::contrastChanged);
+    QSignalSpy motionSpy(&portal, &QGnomePortalInterface::motionChanged);
+    // QDBusListener is not exported, so its enums are passed by name
+    auto setting = [&portal](QDBusListener::Setting setting, const QVariant &value) {
+        const auto provider = QDBusListener::Provider::Gnome;
+        QVERIFY(QMetaObject::invokeMethod(&portal, "dbusSettingChanged",
+                                          QGenericArgument("QDBusListener::Provider", &provider),
+                                          QGenericArgument("QDBusListener::Setting", &setting),
+                                          QGenericArgument("QVariant", &value)));
+    };
+
+    setting(QDBusListener::Setting::ColorScheme, QVariant::fromValue(Qt::ColorScheme::Unknown));
+    setting(QDBusListener::Setting::Contrast, QVariant::fromValue(Qt::ContrastPreference::NoPreference));
+    setting(QDBusListener::Setting::Motion, QVariant::fromValue(Qt::MotionPreference::NoPreference));
+    QCOMPARE(colorSchemeSpy.size(), 0);
+    QCOMPARE(contrastSpy.size(), 0);
+    QCOMPARE(motionSpy.size(), 0);
+
+    setting(QDBusListener::Setting::ColorScheme, QVariant::fromValue(Qt::ColorScheme::Dark));
+    setting(QDBusListener::Setting::ColorScheme, QVariant::fromValue(Qt::ColorScheme::Dark));
+    QCOMPARE(colorSchemeSpy.size(), 1);
+    QCOMPARE(portal.colorScheme(), Qt::ColorScheme::Dark);
+}
+
+QTEST_GUILESS_MAIN(tst_QGnomePortalInterface)
+#include "tst_qgnomeportalinterface.moc"
